-    for (const line of lines) {
-      if (line.startsWith("data: ")) {
-        try {
-          const event = JSON.parse(line.slice(6)) as SSEEvent;
-          yield event;
-        } catch {
-          // Malformed SSE line — skip
-        }
-      }
-    }
-  }
