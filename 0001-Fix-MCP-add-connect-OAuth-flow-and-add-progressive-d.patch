+                            </span>
+                          </div>
+                          {server.description && (
+                            <p className="text-text-muted text-2xs mt-0.5 line-clamp-2">{server.description}</p>
+                          )}
+                          <div className="flex items-center gap-3 mt-1.5">
+                            <span
